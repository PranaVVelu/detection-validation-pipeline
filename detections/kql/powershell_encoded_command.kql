// @id: 9c3e1a72-5d08-4f6b-b1e7-40a8d2c6f915
// @title: PowerShell Launched With Encoded Command (Defender XDR)
// @techniques: T1059.001
// @atomic_test: a538de64-1c74-46ed-aa60-b995ed302598
DeviceProcessEvents
| where FileName in~ ("powershell.exe", "pwsh.exe")
// Matches -e, -ec, and every abbreviation up to -encodedcommand, but not -ExecutionPolicy.
| where ProcessCommandLine matches regex @"(?i)\s-(ec|e(n(c(o(d(e(d(c(o(m(m(a(nd?)?)?)?)?)?)?)?)?)?)?)?)?)\s"
| project DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
